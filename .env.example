# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

# --- Apify (used-car listings) — see docs/apify-listings.md ---
# Required. "live" runs the AutoTrader listings Actor on Apify (billed per run);
# "mock" uses seeded demo listings. There is no default: leaving it unset makes
# /api/pipeline return 503.
APIFY_MODE=mock

# Required when APIFY_MODE=live. console.apify.com → Settings → API & Integrations.
APIFY_API_TOKEN=

# Optional. Defaults shown. The mapper targets this Actor's output schema.
# APIFY_LISTINGS_ACTOR_ID=caffein.dev/autotrader-com-actor
# APIFY_SEARCH_RADIUS_MILES=50       # one of 10, 25, 50, 75, 100, 200, 300, 400, 500
# APIFY_MAX_ITEMS=25                 # 1–100 listings per run
# APIFY_MAX_CHARGE_USD=0.25          # hard spend cap per run, at most 5
# APIFY_RUN_TIMEOUT_SECS=120         # 1–300
# APIFY_BASE_URL=https://api.apify.com/v2
