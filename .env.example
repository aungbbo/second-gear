# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

# Required. "live" reads the Capital One Nessie sandbox; "mock" uses seeded demo
# numbers. There is no default: leaving it unset makes /api/pipeline return 503.
NESSIE_MODE=mock

# Required when NESSIE_MODE=live. Get a key at https://api.nessieisreal.com
NESSIE_API_KEY=
# The sandbox customer whose accounts are analyzed.
NESSIE_CUSTOMER_ID=

# Optional. Defaults to https://api.nessieisreal.com
# NESSIE_BASE_URL=

# Demo data: npm run nessie:seed (dry run), see docs/nessie-sandbox.md

# --- CRS Credit API (soft-pull prequalification) ---
# Required. "live" pulls a real CRS sandbox prequal report; "mock" uses seeded demo
# numbers. No default: leaving it unset makes /api/pipeline return 503.
CRS_MODE=mock
# Required when CRS_MODE=live. Sandbox credentials from the CRS team. Quote the
# password: an unquoted "#" starts a comment and cuts it short.
CRS_USERNAME=
CRS_PASSWORD=""
# The allowlisted CRS sandbox persona to pull (only P05 for now) and its sandbox SSN
# (9 digits, from the CRS CalHacks persona list). Server-side only.
CRS_TEST_PERSONA=P05
CRS_PERSONA_SSN=
# Optional. Defaults: experian / exp-prequal-vantage4 / https://api-sandbox.stitchcredit.com/api
# CRS_BUREAU=
# CRS_CONFIG=
# CRS_BASE_URL=
# Optional. HMAC secret (32+ chars) for consent tokens; a random per-process secret is used otherwise.
# CONSENT_SIGNING_SECRET=
