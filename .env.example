# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

# Required. "live" reads the Capital One Nessie sandbox; "mock" uses seeded demo
# numbers. There is no default: leaving it unset makes /api/pipeline return 503.
NESSIE_MODE=mock

# Required when NESSIE_MODE=live. Get a key at https://prod.nessieisreal.com (docs: /docs)
NESSIE_API_KEY=
# The sandbox customer whose accounts are analyzed.
NESSIE_CUSTOMER_ID=

# Optional. Defaults to https://prod-api.nessieisreal.com
# NESSIE_BASE_URL=

# Demo data: npm run nessie:seed (dry run), see docs/nessie-sandbox.md

# --- CRS Credit API (soft-pull prequalification) ---
# Required. "live" pulls a real CRS sandbox prequal report; "mock" uses seeded demo
# numbers. No default: leaving it unset makes /api/pipeline return 503.
CRS_MODE=mock
# Required when CRS_MODE=live. Sandbox credentials from the CRS team. Quote the
# password: an unquoted "#" starts a comment and cuts it short.
CRS_USERNAME=
CRS_PASSWORD=""
# The allowlisted CRS sandbox persona to pull (only P05 for now) and its sandbox SSN
# (9 digits, from the CRS CalHacks persona list). Server-side only.
CRS_TEST_PERSONA=P05
CRS_PERSONA_SSN=
# Optional. Defaults: experian / exp-prequal-vantage4 / https://api-sandbox.stitchcredit.com/api
# CRS_BUREAU=
# CRS_CONFIG=
# CRS_BASE_URL=
# Consent replay protection. Set CONSENT_STORE=memory only for local development/tests.
CONSENT_STORE=memory
# Local development/tests only; production uses Upstash rate limiting.
RATE_LIMIT_MODE=memory
# Production requires CONSENT_STORE=upstash, a 32+ byte HMAC secret, and both Upstash values.
# CONSENT_SIGNING_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Production Vercel origin used for same-origin API requests.
# APP_ORIGIN=https://your-demo.vercel.app
# Public deployments should keep mock mode. Live CRS requires all of the following.
# CRS_LIVE_PULLS_ENABLED=false
# CRS_LIVE_ACCESS_TOKEN=
# CRS_GLOBAL_PULL_LIMIT=5
# CRS_GLOBAL_PULL_WINDOW_SECONDS=86400
# CRS_KILL_SWITCH_KEY=second-gear:controls:crs-live-pulls

# --- Bitdeer AI Model Studio (ranking + explanations) ---
# Used by src/lib/providers/bitdeer.ts to rank cars and write explanations.
# When unset, that step falls back to a deterministic local scoring/template.
BITDEER_API_KEY=

# --- Apify (used-car listings) — see docs/apify-listings.md ---
# Required. "live" runs the AutoTrader listings Actor on Apify (billed per run);
# "mock" uses seeded demo listings. There is no default: leaving it unset makes
# /api/pipeline return 503.
APIFY_MODE=mock

# Required when APIFY_MODE=live. console.apify.com → Settings → API & Integrations.
APIFY_API_TOKEN=

# Optional. Defaults shown. The mapper targets this Actor's output schema.
# APIFY_LISTINGS_ACTOR_ID=caffein.dev/autotrader-com-actor
# APIFY_SEARCH_RADIUS_MILES=50       # one of 10, 25, 50, 100, 200, 500
# APIFY_MAX_ITEMS=25                 # 1–100 listings per run
# APIFY_MAX_CHARGE_USD=0.25          # hard spend cap per run, at most 5
# APIFY_RUN_TIMEOUT_SECS=120         # 1–240; the run is aborted past this
# Cost guard (per server instance):
# APIFY_MAX_RUNS_PER_HOUR=10         # paid runs started per rolling hour
# APIFY_DAILY_BUDGET_USD=2           # worst-case spend per rolling 24 h (MAX_CHARGE_USD per run)
# APIFY_MAX_CONCURRENT_RUNS=2
# APIFY_CACHE_TTL_SECS=900           # identical searches reuse the result; 0 disables
# APIFY_BASE_URL=https://api.apify.com/v2
